AI_DAILY_LIMIT_GLOBAL=150
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional long random secret; lets the owner test the AI past the per-IP cap (header X-Milo-Owner)
AI_OWNER_KEY=

